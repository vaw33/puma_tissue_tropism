  mutate(Letter = str_squish(.group), age = "sy") %>%
  dplyr::select(tissue_type, age, Letter)

cld_combined <- bind_rows(cld_asy, cld_sy)

# Compile table of means, standard deviations, and min/max ranges
combined_table <- df_long %>%
  group_by(tissue_type, age) %>%
  summarize(
    n = n(),
    Mean = mean(hg_conc, na.rm = TRUE),
    SD = sd(hg_conc, na.rm = TRUE),
    Min = min(hg_conc, na.rm = TRUE),
    Max = max(hg_conc, na.rm = TRUE),
    .groups = 'drop'
  ) %>%
  left_join(cld_combined, by = c("tissue_type", "age")) %>%
  mutate(Letter = replace_na(Letter, "")) %>%
  mutate(
    `THg (ug/g)` = sprintf("%.3f ± %.3f %s", Mean, SD, Letter),
    `min-max` = sprintf("%.3f – %.3f", Min, Max)
  ) %>%
  dplyr::select(tissue_type, age, n, `THg (ug/g)`, `min-max`) %>%
  pivot_wider(
    id_cols = tissue_type,
    names_from = age,
    values_from = c(n, `THg (ug/g)`, `min-max`)
  ) %>%
  rename(
    `Adult (n)` = n_asy,
