    Max  = max(hg_conc, na.rm = TRUE),
    .groups = 'drop'
  ) %>%
  left_join(cld_combined, by = c("tissue_type", "age")) %>%
  mutate(Letter = replace_na(Letter, "")) %>%
  mutate(
    `THg (ug/g)` = sprintf("%.3f ± %.3f %s", Mean, SD, Letter),
    `min-max`    = sprintf("%.3f – %.3f", Min, Max)
  ) %>%
  dplyr::select(tissue_type, age, n, `THg (ug/g)`, `min-max`) %>%
  pivot_wider(
    id_cols = tissue_type,
    names_from = age,
    values_from = c(n, `THg (ug/g)`, `min-max`)
  ) %>%
  rename(
    `Adult (n)`           = n_asy,
    `Adult THg (ug/g)`    = `THg (ug/g)_asy`,
    `Adult min-max`       = `min-max_asy`,
    `Subadult (n)`        = n_sy,
    `Subadult THg (ug/g)` = `THg (ug/g)_sy`,
    `Subadult min-max`    = `min-max_sy`
  ) %>%
  mutate(tissue_type = recode(tissue_type,
                              "wb" = "Whole Body",
                              "gi" = "GI Tract",
                              "pec" = "Pectoralis",
                              "gas" = "Gastrocnemius",
                              "brain" = "Brain",
                              "heart" = "Heart",
                              "lung" = "Lung",
                              "liver" = "Liver"
  )) %>%
  arrange(factor(tissue_type, levels = c(
    "Whole Body", "GI Tract", "Pectoralis", "Gastrocnemius",
    "Brain", "Heart", "Lung", "Liver"
  ))) %>%
  dplyr::select(
    Tissue = tissue_type,
    `Adult (n)`, `Adult THg (ug/g)`, `Adult min-max`,
    `Subadult (n)`, `Subadult THg (ug/g)`, `Subadult min-max`
  )

