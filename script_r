# Convert tissue THg (ug/g dw) to blood-equivalent THg (ug/g ww)
# Equations compiled by Ackerman et al. (2016)
blood_equiv <- df %>%
  left_join(df_feathers, by = "bird_id") %>%
  mutate(
    blood_from_muscle_ww = exp(1.080 * log(pec_ug_g)   - 1.024),
    blood_from_liver_ww  = exp(0.970 * log(liver_ug_g) - 1.929),
    blood_from_breast_ww = exp(0.673 * log(breast)     - 1.673)
  ) %>%
  dplyr::select(bird_id, blood_from_liver_ww, blood_from_muscle_ww, blood_from_breast_ww)

print(blood_equiv, n = Inf)

# Summary statistics and threshold exceedances
blood_summary <- blood_equiv %>%
  pivot_longer(cols = starts_with("blood_from"),
               names_to = "source", values_to = "blood_ww") %>%
  filter(!is.na(blood_ww)) %>%
  group_by(source) %>%
  summarize(
    n      = n(),
    Mean   = mean(blood_ww),
    SD     = sd(blood_ww),
    Median = median(blood_ww),
    Min    = min(blood_ww),
    Max    = max(blood_ww),
    n_0.2  = sum(blood_ww > 0.2), pct_0.2 = 100 * mean(blood_ww > 0.2),
    n_0.3  = sum(blood_ww > 0.3), pct_0.3 = 100 * mean(blood_ww > 0.3),
    n_0.4  = sum(blood_ww > 0.4), pct_0.4 = 100 * mean(blood_ww > 0.4),
    n_0.5  = sum(blood_ww > 0.5), pct_0.5 = 100 * mean(blood_ww > 0.5),
    .groups = "drop"
  )

print("--- BLOOD-EQUIVALENT SUMMARY (Table 3) ---")
print(blood_summary, width = Inf)

write_csv(blood_summary, "Table_3_Blood_Equivalent.csv")
