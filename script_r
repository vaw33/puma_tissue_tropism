# Convert tissue THg (ug/g dw) to blood-equivalent THg (ug/g ww)
# Equations compiled by Ackerman et al. (2016)
blood_equiv <- df %>%
  left_join(df_feathers, by = "bird_id") %>%
  mutate(
    blood_from_muscle_ww = exp(1.080 * log(pec_ug_g)   - 1.024),
    blood_from_liver_ww  = exp(0.970 * log(liver_ug_g) - 1.929),
    blood_from_breast_ww = exp(0.673 * log(breast)     - 1.673)
  ) %>%
  dplyr::select(bird_id, blood_from_liver_ww, blood_from_muscle_ww, blood_from_breast_ww)

print(blood_equiv)   # n = Inf is a tibble argument; blood_equiv is a data.frame

# Summary statistics and threshold exceedances
blood_summary <- blood_equiv %>%
  pivot_longer(cols = starts_with("blood_from"),
               names_to = "source", values_to = "blood_ww") %>%
