# ==============================================================================
# 7. CORRELATION HEAT MAP: ORGANS AND FEATHERS  --  FIGURE 4
# ==============================================================================

pal_corr      <- colorRampPalette(c("#2F4B85", "#F8FAFC", "#C1553A"))(200)  # S1/S2 heatmaps
pal_corr_fig4 <- colorRampPalette(c("#F8FAFC", "#C1553A"))(200)             # Fig 4: white at 0 -> red at 1


# Format dataset for correlation matrix
cor_data_final <- df_merged %>%
  dplyr::select(brain_ug_g, heart_ug_g, lung_ug_g, liver_ug_g, gi_ug_g,
                pec_ug_g, gas_ug_g, wb_ug_g,
                pr, pl, rr, rl, crown, dorsal, breast) %>%
  rename(
    Brain = brain_ug_g, Liver = liver_ug_g, Lung = lung_ug_g,
    Heart = heart_ug_g, Pectoralis = pec_ug_g,
    `GI Tract` = gi_ug_g, Gastrocnemius = gas_ug_g,
    `Whole Body` = wb_ug_g,
    `R. Rectrix` = rr, `L. Rectrix` = rl, Crown = crown,
    `R. Primary` = pr, `L. Primary` = pl, Dorsal = dorsal, Breast = breast
  )

# Calculate correlations
res_final <- cor(cor_data_final, method = "pearson", use = "pairwise.complete.obs")

# Matrix of p-values for the same pairs
p_final <- corrplot::cor.mtest(cor_data_final, method = "pearson")$p
diag(p_final) <- 0

# Flat light blue for non-significant cells
pal_ns <- rep("#BFD3E6", 200)

# Split the matrix; NA cells are skipped because na.label = " "
res_sig <- res_final; res_sig[p_final >= 0.05] <- NA
res_ns  <- res_final; res_ns[p_final <  0.05] <- NA

# Arguments shared by both passes
args_common <- list(
  method      = "circle",
  type        = "upper",
  is.corr     = FALSE,
  col.lim     = c(0, 1),
  addCoef.col = "black",
  number.cex  = 0.5,
  diag        = FALSE,
  mar         = c(0, 0, 1, 0),
  na.label    = " "
)

# Significant cells on the red ramp, then non-significant cells overlaid in blue
draw_fig4 <- function() {
  suppressWarnings(do.call(corrplot, c(list(corr = res_sig, col = pal_corr_fig4,
                                            tl.col = "black", tl.srt = 45, tl.cex = 0.7, cl.cex = 0.7), args_common)))
  suppressWarnings(do.call(corrplot, c(list(corr = res_ns, col = pal_ns,
                                            tl.pos = "n", cl.pos = "n", bg = "transparent", add = TRUE), args_common)))
}

# Build Correlation Matrix Plot (screen)
draw_fig4()

# Export as vector PDF
cairo_pdf("Figure4_uncorrected.pdf", width = 6.9, height = 6)
draw_fig4()
dev.off()

# Extract Top Predictors/Proxies
cor_long <- as.data.frame(as.table(res_final))

organs   <- c("Brain", "Liver", "Lung", "Heart", "Pectoralis",
              "GI Tract", "Gastrocnemius", "Whole Body")
feathers <- c("R. Rectrix", "L. Rectrix", "Crown", "R. Primary",
              "L. Primary", "Dorsal", "Breast")

top_proxies <- cor_long %>%
  filter(Var1 %in% organs) %>%
  filter(Var2 %in% feathers) %>%
  arrange(Var1, desc(Freq)) %>%
  group_by(Var1) %>%
  slice_max(Freq, n = 1) %>%
  ungroup() %>%
  rowwise() %>%
  mutate(
    p_value = cor.test(cor_data_final[[as.character(Var1)]],
                       cor_data_final[[as.character(Var2)]],
                       method = "pearson")$p.value
  ) %>%
  ungroup() %>%
  mutate(
    p_format = if_else(p_value < 0.001, "< 0.001", sprintf("%.3f", p_value))
  ) %>%
  dplyr::select(
    `Internal Tissue` = Var1,
    `External Proxy`  = Var2,
    `Pearson r`       = Freq,
    `p-value`         = p_format
  )

print("--- TOP PROXIES (WITH P-VALUES) ---")
print(top_proxies)

# Check exact correlation value for specific pairs
print(round(res_final["Lung", c("R. Primary", "L. Primary")], 4))

