# ==============================================================================
# PURPLE MARTIN TISSUE TROPISM: DATA ANALYSIS & VISUALIZATION
# ==============================================================================

# Load required packages
library(tidyverse)
library(lme4)         # Mixed-effects models
library(emmeans)      # Post-hoc pairwise comparisons
library(lmerTest)     # p-values for lme4 models
library(performance)  # Model diagnostics
library(corrplot)     # Correlation heatmaps
library(multcompView) # Significance letter extraction
library(multcomp)
library(patchwork)    # Plot assembly

set.seed(20251102)    # For geom_jitter reproducibility

# ==============================================================================
# FIGURE PALETTE — light teal / gold (colorblind-safe) with Lavender integration
# ==============================================================================

pal_age    <- c("asy" = "#2B9E9E", "sy" = "#D4A017")   # box fills
pal_age_pt <- c("asy" = "#1B7C7C", "sy" = "#8F6C0F")   # jittered points

# Updated Figure 2 palette to match the lavender theme
pal_cat    <- c("Whole Body"     = "#F2E6EB", 
                "Organs (Avg)"   = "#D7C0CC", 
                "Feathers (Avg)" = "#906C7E")
pal_cat_pt <- c("Whole Body"     = "#5E4352", 
                "Organs (Avg)"   = "#5E4352", 
                "Feathers (Avg)" = "#5E4352") # Darker shade for contrast

# Shared base theme
theme_pm <- function(base_size = 11) {
  theme_classic(base_size = base_size) +
    theme(
      axis.text        = element_text(face = "plain", color = "black"),
      axis.title       = element_text(face = "plain"),
      legend.text      = element_text(face = "plain"),
      axis.line        = element_line(linewidth = 0.4, color = "black"),
      axis.ticks       = element_line(linewidth = 0.3, color = "black"),
      strip.background = element_blank(),
      strip.text       = element_text(face = "plain", size = 10)
    )
}


# ==============================================================================
# 1. DATA IMPORT & PREPARATION
# ==============================================================================

setwd("/path/to/wd")

# Load primary tissue data (testes excluded from current analyses)
df <- read.csv("/path/to/organdf/all_data_wide_uncorrected.csv") %>%
  dplyr::select(-testes_ug_g)

df_feathers <- read.csv("/path/to/featherdf/feather_data_uncorrected.csv")

# Convert tissue data to long format for modeling
df_long <- df %>%
  dplyr::select(bird_id, sex, age, ends_with("_ug_g")) %>%
  pivot_longer(
    cols = ends_with("_ug_g"),
    names_to = "tissue_type",
    values_to = "hg_conc"
  ) %>%
  filter(!is.na(hg_conc)) %>%
  mutate(tissue_type = str_replace(tissue_type, "_ug_g", ""))


# ==============================================================================
# 2. ASSUMPTION CHECKS (NORMALITY & VARIANCE)
# ==============================================================================

# Global raw data model for diagnostics
model_global_raw <- lmer(hg_conc ~ tissue_type * age + (1 | bird_id), data = df_long)
check_model(model_global_raw)

# Formal statistical tests for assumptions
print("--- SHAPIRO-WILK TEST (RAW) ---")
print(shapiro.test(resid(model_global_raw)))

print("--- BARTLETT'S TEST (TISSUE ONLY) ---")
print(bartlett.test(hg_conc ~ tissue_type, data = df_long))

print("--- BARTLETT'S TEST (TISSUE x AGE) ---")
print(bartlett.test(hg_conc ~ interaction(tissue_type, age), data = df_long))

# Log10-transformation assessment
df_long <- df_long %>%
  mutate(log_hg = log10(hg_conc))

model_global_log <- lmer(log_hg ~ tissue_type * age + (1 | bird_id), data = df_long)

print("--- SHAPIRO-WILK TEST (LOG-TRANSFORMED) ---")
print(shapiro.test(resid(model_global_log)))

print("--- BARTLETT'S TEST (LOG-TRANSFORMED) ---")
print(bartlett.test(log_hg ~ tissue_type, data = df_long))


# ==============================================================================
# 3. DEMOGRAPHIC EFFECTS (AGE & SEX)
# ==============================================================================

# 3A. Internal Tissues
model_organs <- lmer(hg_conc ~ tissue_type * age + tissue_type * sex + (1 | bird_id),
                     data = df_long)
anova(model_organs)

print("--- Age Comparisons within Internal Tissues ---")
summary(emmeans(model_organs, pairwise ~ age | tissue_type, adjust = "tukey")$contrasts)

print("--- Sex Comparisons within Internal Tissues ---")
summary(emmeans(model_organs, pairwise ~ sex | tissue_type, adjust = "tukey")$contrasts)

# 3B. External Tissues (Feathers)
df_feathers_long <- df_feathers %>%
  dplyr::select(bird_id, sex, age, rr, rl, crown, pr, pl, dorsal, breast) %>%
  pivot_longer(
    cols = c(rr, rl, crown, pr, pl, dorsal, breast),
    names_to = "feather_type",
    values_to = "hg_conc"
  ) %>%
  filter(!is.na(hg_conc))

model_feathers <- lmer(hg_conc ~ feather_type * age + feather_type * sex + (1 | bird_id),
                       data = df_feathers_long)
anova(model_feathers)

print("--- Age Comparisons within Feathers ---")
summary(emmeans(model_feathers, pairwise ~ age | feather_type, adjust = "tukey")$contrasts)

print("--- Sex Comparisons within Feathers ---")
summary(emmeans(model_feathers, pairwise ~ sex | feather_type, adjust = "tukey")$contrasts)


# ==============================================================================
# 4. TISSUE TROPISM COMPARISONS -- FIGURE 1
# ==============================================================================

# Define and apply consistent tissue ordering
tissue_order <- c("wb", "gi", "pec", "gas", "brain", "heart", "lung", "liver")
df_long <- df_long %>%
  mutate(tissue_type = factor(tissue_type, levels = tissue_order))

# Ensure age factor levels match strictly for position dodging
df_long$age <- factor(df_long$age, levels = c("asy", "sy"))

df_asy <- df_long %>% filter(age == "asy")
df_sy  <- df_long %>% filter(age == "sy")

model_asy <- lmer(hg_conc ~ tissue_type + (1 | bird_id), data = df_asy)
model_sy  <- lmer(hg_conc ~ tissue_type + (1 | bird_id), data = df_sy)

# Post-hoc letters 
cld_tissue <- bind_rows(
  multcomp::cld(emmeans(model_asy, ~ tissue_type), alpha = 0.05,
                Letters = letters, adjust = "tukey") %>%
    as.data.frame() %>% mutate(age = "asy"),
  multcomp::cld(emmeans(model_sy,  ~ tissue_type), alpha = 0.05,
                Letters = letters, adjust = "tukey") %>%
    as.data.frame() %>% mutate(age = "sy")
) %>%
  mutate(
    .group = str_squish(.group),
    age    = factor(age, levels = c("asy", "sy"))
  )

max_vals_tissue <- df_long %>%
  group_by(tissue_type, age) %>%
  summarize(max_hg = max(hg_conc, na.rm = TRUE), .groups = 'drop')

cld_tissue_plot <- left_join(cld_tissue, max_vals_tissue, by = c("tissue_type", "age"))

# Constant vertical offsets (data units) so every tissue's label sits the same
# distance above its box; a multiplicative offset crowds the low tissues.
lab_gap  <- 0.040 * diff(range(df_long$hg_conc, na.rm = TRUE))
star_gap <- 0.095 * diff(range(df_long$hg_conc, na.rm = TRUE))

# Asterisks derived from the model rather than hard-coded, so they cannot go stale.
age_tab <- as.data.frame(
    summary(emmeans(model_organs, pairwise ~ age | tissue_type,
                    adjust = "tukey")$contrasts)) %>%
  mutate(stars = case_when(p.value < 0.001 ~ "***", p.value < 0.01 ~ "**",
                           p.value < 0.05  ~ "*",   TRUE ~ "")) %>%
  filter(stars != "")

sig_asterisk <- df_long %>%
  filter(tissue_type %in% age_tab$tissue_type) %>%
  group_by(tissue_type) %>%
  summarize(y_position = max(hg_conc, na.rm = TRUE) + star_gap, .groups = "drop") %>%
  left_join(age_tab %>% dplyr::select(tissue_type, label = stars), by = "tissue_type")

# Build Figure 1
fig1 <- ggplot(df_long, aes(x = tissue_type, y = hg_conc, fill = age)) +
  geom_boxplot(alpha = 0.6, outlier.shape = NA, linewidth = 0.35,
               position = position_dodge(width = 0.8)) +
  geom_jitter(aes(color = age), alpha = 0.55, size = 0.5,
              position = position_jitterdodge(jitter.width = 0.15, dodge.width = 0.8)) +
  geom_text(data = cld_tissue_plot,
            aes(x = tissue_type, y = max_hg + lab_gap, label = .group, group = age),
            position = position_dodge(width = 0.8),
            inherit.aes = FALSE, size = 3.0, color = "gray20") +
  geom_text(data = sig_asterisk,
            aes(x = tissue_type, y = y_position, label = label),
            inherit.aes = FALSE, size = 4) +
  scale_fill_manual(values = pal_age, labels = c("asy" = "Adult", "sy" = "Subadult")) +
  scale_color_manual(values = pal_age_pt, labels = c("asy" = "Adult", "sy" = "Subadult")) +
  scale_x_discrete(labels = c("wb" = "Whole Body", "gi" = "GI Tract", "pec" = "Pectoralis",
                              "gas" = "Gastrocnemius", "brain" = "Brain", "heart" = "Heart",
                              "lung" = "Lung", "liver" = "Liver")) +
  scale_y_continuous(expand = expansion(mult = c(0.05, 0.20))) +
  theme_pm(base_size = 11) +
  theme(
    axis.text.x = element_text(angle = 45, hjust = 1),
    legend.position = "top",
    legend.title = element_blank(),
    panel.grid.major.y = element_line(linewidth = 0.2, color = "gray92")
  ) +
  labs(x = "Tissue", y = "THg concentration (μg/g dw)")

# Reset graphics drivers if a background PDF device crashed previously
graphics.off()

# Print to screen and save
print(fig1)
ggsave("Figure1_uncorrected.pdf", plot = fig1, width = 6.9, height = 5, units = "in", device = cairo_pdf)


