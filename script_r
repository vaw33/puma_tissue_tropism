# ==============================================================================
# PURPLE MARTIN TISSUE TROPISM: DATA ANALYSIS & VISUALIZATION
# ==============================================================================

# Load required packages
library(tidyverse)
library(lme4)         # Mixed-effects models
library(emmeans)      # Post-hoc pairwise comparisons
library(lmerTest)     # p-values for lme4 models
library(performance)  # Model diagnostics
library(corrplot)     # Correlation heatmaps
library(multcompView) # Significance letter extraction
library(multcomp)
library(patchwork)    # Plot assembly


# ==============================================================================
# 1. DATA IMPORT & PREPARATION
# ==============================================================================

# Load primary tissue data (testes excluded from current analyses)
df <- read.csv("/Users/victoriawiley/Library/CloudStorage/Dropbox/Documents/_PhD/Research/ch2_tissue_tropism/analysis/all_data_wide_with_wb_10rmvd_use.csv") %>%
  dplyr::select(-testes_ug_g)

df_feathers <- read.csv("/Users/victoriawiley/Library/CloudStorage/Dropbox/Documents/_PhD/Research/ch2_tissue_tropism/analysis/feathers/feather_data_updated.csv")

# Convert tissue data to long format for modeling
df_long <- df %>%
  dplyr::select(bird_id, sex, age, ends_with("_ug_g")) %>%
  pivot_longer(
    cols = ends_with("_ug_g"),
    names_to = "tissue_type",
    values_to = "hg_conc"
  ) %>%
  filter(!is.na(hg_conc)) %>%
  mutate(tissue_type = str_replace(tissue_type, "_ug_g", ""))


# ==============================================================================
# 2. ASSUMPTION CHECKS (NORMALITY & VARIANCE)
# ==============================================================================

# Global raw data model for diagnostics
model_global_raw <- lmer(hg_conc ~ tissue_type * age + (1 | bird_id), data = df_long)
check_model(model_global_raw)

# Formal statistical tests for assumptions
print("--- SHAPIRO-WILK TEST (RAW) ---")
print(shapiro.test(resid(model_global_raw)))

print("--- BARTLETT'S TEST (TISSUE ONLY) ---")
print(bartlett.test(hg_conc ~ tissue_type, data = df_long))

print("--- BARTLETT'S TEST (TISSUE x AGE) ---")
print(bartlett.test(hg_conc ~ interaction(tissue_type, age), data = df_long))

# Log10-transformation assessment
df_long <- df_long %>%
  mutate(log_hg = log10(hg_conc))

model_global_log <- lmer(log_hg ~ tissue_type * age + (1 | bird_id), data = df_long)

print("--- SHAPIRO-WILK TEST (LOG-TRANSFORMED) ---")
print(shapiro.test(resid(model_global_log)))

print("--- BARTLETT'S TEST (LOG-TRANSFORMED) ---")
print(bartlett.test(log_hg ~ tissue_type, data = df_long))


# ==============================================================================
# 3. DEMOGRAPHIC EFFECTS (AGE & SEX)
# ==============================================================================

# 3A. Internal Tissues
model_organs <- lmer(hg_conc ~ tissue_type * age + tissue_type * sex + (1 | bird_id),
                     data = df_long)
anova(model_organs)

print("--- Age Comparisons within Internal Tissues ---")
summary(emmeans(model_organs, pairwise ~ age | tissue_type, adjust = "tukey")$contrasts)

print("--- Sex Comparisons within Internal Tissues ---")
summary(emmeans(model_organs, pairwise ~ sex | tissue_type, adjust = "tukey")$contrasts)

# 3B. External Tissues (Feathers)
df_feathers_long <- df_feathers %>%
  dplyr::select(bird_id, sex, age, rr, rl, crown, pr, pl, dorsal, breast) %>%
  pivot_longer(
    cols = c(rr, rl, crown, pr, pl, dorsal, breast),
    names_to = "feather_type",
    values_to = "hg_conc"
  ) %>%
  filter(!is.na(hg_conc))

model_feathers <- lmer(hg_conc ~ feather_type * age + feather_type * sex + (1 | bird_id),
                       data = df_feathers_long)
anova(model_feathers)

print("--- Age Comparisons within Feathers ---")
summary(emmeans(model_feathers, pairwise ~ age | feather_type, adjust = "tukey")$contrasts)

print("--- Sex Comparisons within Feathers ---")
summary(emmeans(model_feathers, pairwise ~ sex | feather_type, adjust = "tukey")$contrasts)


# ==============================================================================
# 4. TISSUE TROPISM COMPARISONS  --  FIGURE 1
# ==============================================================================

# Split data by age cohort for internal tissue comparisons
df_asy <- df_long %>% filter(age == "asy")
df_sy  <- df_long %>% filter(age == "sy")

# Adult (ASY) pairwise comparisons
model_asy <- lmer(hg_conc ~ tissue_type + (1 | bird_id), data = df_asy)
anova(model_asy)
print("--- Adult Internal Tropism Post-Hocs ---")
summary(emmeans(model_asy, pairwise ~ tissue_type, adjust = "tukey")$contrasts)

# Subadult (SY) pairwise comparisons
model_sy <- lmer(hg_conc ~ tissue_type + (1 | bird_id), data = df_sy)
anova(model_sy)
print("--- Subadult Internal Tropism Post-Hocs ---")
summary(emmeans(model_sy, pairwise ~ tissue_type, adjust = "tukey")$contrasts)

# Generate significance letters for plot annotations
emm_tissue <- emmeans(model_organs, ~ tissue_type | age)
cld_tissue <- cld(emm_tissue, alpha = 0.05, Letters = letters, adjust = "tukey") %>%
  mutate(.group = str_squish(.group))

max_vals_tissue <- df_long %>%
  group_by(tissue_type, age) %>%
  summarize(max_hg = max(hg_conc, na.rm = TRUE), .groups = 'drop')

cld_tissue_plot <- left_join(cld_tissue, max_vals_tissue, by = c("tissue_type", "age"))

# Define significant age difference annotations (asterisks)
sig_asterisk <- data.frame(
  tissue_type = c("lung", "brain"),
  y_position = c(
    max(df_long$hg_conc[df_long$tissue_type == "lung"],  na.rm = TRUE) + 0.30,
    max(df_long$hg_conc[df_long$tissue_type == "brain"], na.rm = TRUE) + 0.30
  ),
  label = c("***", "*")
)

# Order factor levels from lowest to highest overall concentration
df_long$tissue_type <- factor(df_long$tissue_type,
                              levels = c("wb", "gi", "pec", "gas", "brain",
                                         "heart", "lung", "liver"))

# Build Tissue Tropism Boxplot
fig1 <- ggplot(df_long, aes(x = tissue_type, y = hg_conc, fill = age)) +
  geom_boxplot(alpha = 0.5, outlier.shape = NA, position = position_dodge(width = 0.8)) +
  geom_jitter(aes(color = age), alpha = 0.6, size = 0.5,
              position = position_jitterdodge(jitter.width = 0.15, dodge.width = 0.8)) +
  
  # Significance letters
  geom_text(data = cld_tissue_plot,
            aes(x = tissue_type, y = max_hg + 0.10, label = .group, group = age),
            position = position_dodge(width = 0.8),
            inherit.aes = FALSE, size = 3.0, fontface = "plain") +
  
