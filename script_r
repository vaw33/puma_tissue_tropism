                              "lung" = "Lung", "liver" = "Liver")) +
  
  theme_minimal(base_size = 11) +
  theme(
    axis.text.x = element_text(angle = 45, hjust = 1, face = "plain"),
    axis.title  = element_text(face = "plain"),
    legend.position = "top",
    legend.title = element_blank(),
    panel.grid.major.x = element_blank()
  ) +
