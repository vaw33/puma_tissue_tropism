# Extract CLD letters for summary table
emm_asy <- emmeans(model_asy, ~ tissue_type)
cld_asy <- cld(emm_asy, alpha = 0.05, Letters = letters, adjust = "tukey") %>%
  mutate(Letter = str_squish(.group), age = "asy") %>%
  dplyr::select(tissue_type, age, Letter)

