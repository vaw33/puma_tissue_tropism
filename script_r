            aes(x = tissue_type, y = y_position, label = label),
            inherit.aes = FALSE, size = 4, fontface = "plain") +
  
  scale_fill_manual(values = c("asy" = "#4A90E2", "sy" = "#F5A623"),
                    labels = c("asy" = "Adult", "sy" = "Subadult")) +
  scale_color_manual(values = c("asy" = "#2C5A8D", "sy" = "#B37300"),
