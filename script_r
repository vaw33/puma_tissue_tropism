    hjust = 1.1, vjust = 1.5, size = 3, color = "gray20", inherit.aes = FALSE
  ) +
  coord_cartesian(xlim = c(0, 2.0), ylim = c(0, 1.0)) +
  theme_pm(base_size = 11) +
  theme(
    panel.grid.major = element_line(linewidth = 0.2, color = "gray92"),
    panel.border     = element_rect(color = "gray80", fill = NA, linewidth = 0.5),
    strip.text       = element_text(size = 11),
    axis.line        = element_blank(),
    axis.title.x  = element_text(margin = margin(t = 10)),
