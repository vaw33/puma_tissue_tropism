# 6. LINEAR REGRESSION: ORGANS VS WHOLE BODY  --  FIGURE 3
# ==============================================================================

# Format data for regression
df_reg <- df %>%
  dplyr::select(bird_id, sex, age, wb_ug_g, ends_with("_ug_g")) %>%
  pivot_longer(
    cols = ends_with("_ug_g") & !wb_ug_g,
    names_to = "organ_type",
    values_to = "organ_hg"
  ) %>%
  mutate(organ_type = str_replace(organ_type, "_ug_g", "")) %>%
  filter(!is.na(organ_hg) & !is.na(wb_ug_g)) %>%
  mutate(organ_type = recode(organ_type,
                             "gi" = "GI Tract",
                             "pec" = "Pectoralis",
                             "gas" = "Gastrocnemius",
                             "brain" = "Brain",
                             "heart" = "Heart",
                             "lung" = "Lung",
                             "liver" = "Liver"
  ))

# Calculate regression statistics
reg_labels <- df_reg %>%
  group_by(organ_type) %>%
  summarize(
    r_squared = summary(lm(wb_ug_g ~ organ_hg))$r.squared,
    p_value   = summary(lm(wb_ug_g ~ organ_hg))$coefficients[2, 4],
    .groups = "drop"
  ) %>%
  mutate(
    p_format   = if_else(p_value < 0.001, "p < 0.001", sprintf("p = %.3f", p_value)),
    plot_label = sprintf("R\u00B2 = %.2f\n%s", r_squared, p_format)
  ) %>%
  arrange(desc(r_squared))

# Set factor levels to order facets by R-squared (largest to smallest)
ordered_organs <- reg_labels$organ_type
df_reg$organ_type     <- factor(df_reg$organ_type,     levels = ordered_organs)
reg_labels$organ_type <- factor(reg_labels$organ_type, levels = ordered_organs)

# Define terrain color palette for the 7 organs 
# (sampling from n=9 avoids the invisible off-white at the end of the spectrum)
pal_terrain <- setNames(terrain.colors(9)[1:7], ordered_organs)

p_top <- ggplot(df_reg %>% filter(organ_type %in% ordered_organs[1:3]),
                aes(x = organ_hg, y = wb_ug_g)) +
  geom_point(alpha = 0.6, color = "black", size = 0.8, shape = 16) +
  geom_smooth(aes(color = organ_type, fill = organ_type), method = "lm", linewidth = 0.6, alpha = 0.25) +
  scale_color_manual(values = pal_terrain) +
  scale_fill_manual(values = pal_terrain) +
  facet_wrap(~ organ_type, ncol = 3) +
  geom_text(
    data = reg_labels %>% filter(organ_type %in% ordered_organs[1:3]),
    aes(x = Inf, y = Inf, label = plot_label),
    hjust = 1.1, vjust = 1.5, size = 3, color = "gray20", inherit.aes = FALSE
  ) +
  coord_cartesian(xlim = c(0, 2.0), ylim = c(0, 1.0)) +
  theme_pm(base_size = 11) +
  theme(
    panel.grid.major   = element_line(linewidth = 0.2, color = "gray92"),
    panel.border       = element_rect(color = "gray80", fill = NA, linewidth = 0.5),
    strip.text         = element_text(size = 11),
    axis.line          = element_blank(),
    axis.line.x        = element_blank(),
    axis.line.x.bottom = element_blank(),
    axis.line.x.top    = element_blank(),
    axis.line.y        = element_blank(),
    axis.line.y.left   = element_blank(),
    axis.line.y.right  = element_blank(),
    axis.title.x  = element_blank(),
    axis.text.x   = element_blank(),
    axis.ticks.x  = element_blank(),
    axis.title.y  = element_blank(),
    panel.spacing = unit(1, "lines"),
    legend.position = "none"
  ) +
  labs(y = NULL)

p_bottom <- ggplot(df_reg %>% filter(organ_type %in% ordered_organs[4:7]),
                   aes(x = organ_hg, y = wb_ug_g)) +
  geom_point(alpha = 0.6, color = "black", size = 0.8, shape = 16) +
  geom_smooth(aes(color = organ_type, fill = organ_type), method = "lm", linewidth = 0.6, alpha = 0.25) +
  scale_color_manual(values = pal_terrain) +
  scale_fill_manual(values = pal_terrain) +
  facet_wrap(~ organ_type, ncol = 4) +
  geom_text(
